const int LED_PIN = 7;

void setup() {
  pinMode(LED_PIN, OUTPUT);
}

void loop() {
  digitalWrite(LED_PIN, LOW);
  delay(1000);

  digitalWrite(LED_PIN, HIGH); 

  for (int i = 0; i < 5; i++) {
    delay(100);                  
    digitalWrite(LED_PIN, LOW);   
    delay(100);                  
    digitalWrite(LED_PIN, HIGH);  
  }

  while (1) {
   
  }
}
